        {
          "id": "2aaf8421-4b39-473e-8aa4-ca28c44f2ecb",
          "name": "Get mobile settings",
          "request": {
            "name": "Get mobile settings",
            "description": {
              "content": "Returns the current mobile settings for the authenticated user.\nThe response includes notification preferences, media settings, AV behavior, and summary-related options.\n<br><br>\n<p>\n  <b>OAuth Scope</b>: ZohoCliq.Profile.READ<br>\n  <b>Duration</b>: 5<br>\n  <b>Threshold</b>: 20 requests per min per user<br>\n  <b>Lock period</b>: 5 minutes<br>\n</p>\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "settings",
                "mobile"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "keys",
                  "value": "<string>",
                  "description": "Key name for which you need to get the value."
                },
                {
                  "disabled": false,
                  "key": "fetch_all",
                  "value": "<boolean>",
                  "description": "If true, returns all mobile setting keys (used by clients)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "ZohoCliq.Bots.READ ZohoCliq.Bots.CREATE ZohoCliq.Bots.UPDATE ZohoCliq.Bots.DELETE ZohoCliq.Webhooks.CREATE ZohoCliq.BotMessages.CREATE ZohoCliq.Channels.UPDATE"
                },
                {
                  "key": "authUrl",
                  "value": "https://accounts.zoho.com/oauth/v2/auth"
                },
                {
                  "key": "grant_type",
                  "value": "implicit"
                }
              ]
            }
          },
          "response": [
